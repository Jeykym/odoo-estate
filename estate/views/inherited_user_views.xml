<odoo>
    <record id="res_users_view_form_inherit_inherited_user" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit.inherited_user</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Real Estate">
                    <field name="property_ids">
                        <list>
                            <field name="name"/>
                            <field name="expected_price"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="res_users_action" model="ir.actions.act_window">
        <field name="name">Estate Users</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>